{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "study-buddy",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
